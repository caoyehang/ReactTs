// 定义 Node 端配置文件的 TypeScript 编译规则。
{
  // 编译器选项。
  "compilerOptions": {
    // 指定 Node 端增量编译缓存文件位置。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // 指定 Node 端目标语法版本。
    "target": "ES2023",
    // 声明 Node 端可用的标准库集合。
    "lib": ["ES2023"],
    // 使用最新 ECMAScript 模块语法。
    "module": "ESNext",
    // 跳过依赖声明文件检查。
    "skipLibCheck": true,

    // 使用面向打包器的模块解析策略。
    "moduleResolution": "bundler",
    // 允许在 import 中包含 TypeScript 扩展名。
    "allowImportingTsExtensions": true,
    // 保持源码中的模块导入导出语法。
    "verbatimModuleSyntax": true,
    // 强制所有文件按模块处理。
    "moduleDetection": "force",
    // 类型检查阶段不输出构建产物。
    "noEmit": true,

    // 开启严格类型检查。
    "strict": true,
    // 禁止未使用的局部变量。
    "noUnusedLocals": true,
    // 禁止未使用的函数参数。
    "noUnusedParameters": true,
    // 仅允许可擦除的 TypeScript 语法。
    "erasableSyntaxOnly": true,
    // 禁止 switch case 意外贯穿。
    "noFallthroughCasesInSwitch": true,
    // 检查副作用导入的可解析性。
    "noUncheckedSideEffectImports": true
  },
  // 指定 Node 端需要检查的配置文件。
  "include": ["vite.config.ts"]
}
